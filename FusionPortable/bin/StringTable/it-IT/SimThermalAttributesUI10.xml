	<label  commandName="SimThermalLoadTemperatureCmd" devLabel="Applied Temperature" translation="Applied Temperature" />
	<label  commandName="SimThermalLoadTemperatureCmdDesc1" devLabel="Prescribe a constant temperature on one or more faces, edges, or vertices." translation="Prescribe a constant temperature on one or more faces, edges, or vertices." />
