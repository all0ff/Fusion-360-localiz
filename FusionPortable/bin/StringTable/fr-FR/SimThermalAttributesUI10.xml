	<label commandName="SimThermalLoadConvectionCmd" devLabel="Convection" translation="Convection"/>
	<label commandName="SimThermalLoadConvectionCmdDesc1" devLabel="Simulate heat transfer between one or more surfaces and a liquid or gas flowing over the surface." translation="Simulez le transfert thermique entre une ou plusieurs surfaces et un écoulement de liquide ou de gaz sur la surface."/>
	<label commandName="SimThermalLoadConvectionCmdDesc2" devLabel="Specify an ambient temperature and a film coefficient to  simulate flow-induced heat transfer, without actually simulating the flow itself. Additionally, you can define the film coefficient to be dependent on the local temperature." translation="Spécifiez une température ambiante et un coefficient d'échange convectif pour simuler un transfert thermique induit par l'écoulement, sans simuler réellement l'écoulement lui-même. Vous pouvez en outre faire en sorte que le coefficient d'échange convectif dépende de la température locale."/>
	<label commandName="SimThermalLoadEmissivityCmd" devLabel="Radiation" translation="Rayonnement"/>
	<label commandName="SimThermalLoadEmissivityCmdDesc1" devLabel="Simulate radiative heat transfer between one or more surfaces and the surrounding environment." translation="Simulez le transfert thermique radiatif entre une ou plusieurs surfaces et l'environnement voisin."/>
	<label commandName="SimThermalLoadEmissivityCmdDesc2" devLabel="Specify an ambient temperature and an emissivity to simulate radiative heat transfer with an external source. Additionally, you can define the emissivity to be dependent on the local temperature." translation="Spécifiez une température ambiante et une émissivité pour simuler un transfert thermique radiatif avec une source externe. En outre, vous pouvez faire en sorte que l'émissivité dépende de la température locale."/>
	<label commandName="SimThermalLoadInternalHeatCmd" devLabel="Internal Heat" translation="Chaleur interne"/>
	<label commandName="SimThermalLoadInternalHeatCmdDesc1" devLabel="Simulate internal heat generation within a part or component." translation="Simulez la génération de chaleur interne dans une pièce ou un composant."/>
	<label commandName="SimThermalLoadInternalHeatCmdDesc2" devLabel="An example is the heat dissipation within an electronic device. You can assign Body Heat either as a total value or as a volumetric condition (per volume). Additionally, you can define Body Heat to be dependent on the component temperature." translation="Un exemple est la dissipation de la chaleur dans un appareil électronique. Vous pouvez attribuer la charge thermique volumique en tant que valeur totale ou en tant que condition volumétrique (par volume). Vous pouvez en outre faire en sorte que la charge thermique volumique dépende de la température du composant."/>
	<label commandName="SimThermalLoadSelectBodyLocation" devLabel="Select location(s) for load (only bodies)." translation="Sélectionnez les emplacements de la charge (corps uniquement)."/>
	<label commandName="SimThermalLoadSelectEdgeLocation" devLabel="Select location(s) for load (only edges)." translation="Sélectionnez les emplacements de la charge (arêtes uniquement)."/>
	<label commandName="SimThermalLoadSelectFaceLocation" devLabel="Select location(s) for load (only faces)." translation="Sélectionnez les emplacements de la charge (uniquement les faces)."/>
	<label commandName="SimThermalLoadSelectLocation" devLabel="Select location(s) for load (face, edge or vertex)." translation="Sélectionnez les emplacements de la charge (face, arête ou sommet)."/>
	<label commandName="SimThermalLoadSelectVertexLocation" devLabel="Select location(s) for load (only vertexes)." translation="Sélectionnez les emplacements de la charge (sommets uniquement)."/>
	<label commandName="SimThermalLoadSurfaceHeatCmd" devLabel="Heat Source" translation="Source thermique"/>
	<label commandName="SimThermalLoadSurfaceHeatCmdDesc1" devLabel="Impose a specific amount of heat directly on one or more surfaces, edges, or vertices." translation="Imposez une quantité de chaleur spécifique directement sur une ou plusieurs surfaces ou arêtes, ou sur un ou plusieurs sommets."/>
	<label commandName="SimThermalLoadSurfaceHeatCmdDesc2" devLabel="You can assign Heat Source either as a total value or as a heat flux (per area). Additionally, you can define Heat Source to be dependent on the local surface temperature." translation="Vous pouvez affecter la source thermique en tant que valeur totale ou flux de chaleur (par surface). En outre, vous pouvez définir la source thermique pour qu'elle soit dépendante de la température de surface locale."/>
	<label commandName="SimThermalLoadTemperatureCmd" devLabel="Applied Temperature" translation="Température appliquée"/>
	<label commandName="SimThermalLoadTemperatureCmdDesc1" devLabel="Prescribe a constant temperature on one or more faces, edges, or vertices." translation="Imposez une température constante sur un ou plusieurs sommets, arêtes ou faces."/>
	<label commandName="SimThermalLoadTemperatureCmdDesc2" devLabel="The applied temperature is held constant throughout the simulation." translation="La température appliquée est maintenue constante tout au long de la simulation."/>
	<label commandName="SimThermalLoadTipsAndTricksDesc" devLabel="To select all faces on a body, select a body or click &lt;b&gt;Select All Faces&lt;/b&gt; and pick any face.&lt;br&gt;For Surface/Internal Heat uncheck &lt;b&gt;Unit Area&lt;/b&gt; to specify the 'total' heat.&lt;br&gt;For Surface/Internal Heat check &lt;b&gt;Unit Area&lt;/b&gt; to specify a 'specific' heat per a unit volume, area or length.&lt;br&gt;For natural Convection (a buoyancy-driven flow with still air), use &lt;b&gt;Coefficient Value&lt;/b&gt; about 5 W/(m^2 C). Use a higher value to simulate faster flow.&lt;br&gt;For Radiation specify a value of &lt;b&gt;Emissivity/Absorptivity&lt;/b&gt; between 0 and 1. Use a lower value for reflective surfaces and a higher value for darker, emittive surfaces." translation="Pour sélectionner toutes les faces d'un corps, sélectionnez un corps, ou cliquez sur &lt;b&gt;Sélectionner toutes les faces&lt;/b&gt; et choisissez une face.&lt;br&gt;Pour la chaleur de surface/interne, décochez &lt;b&gt;Unité de surface&lt;/b&gt; si vous souhaitez spécifier la chaleur totale.&lt;br&gt;Pour la chaleur de surface/interne, cochez &lt;b&gt;Unité de surface&lt;/b&gt; si vous souhaitez spécifier une chaleur spécifique par unité de volume, surface ou longueur.&lt;br&gt;Pour la convection naturelle (écoulement résultant de la flottabilité sans courant d'air), définissez le champ &lt;b&gt;Valeur de coefficient&lt;/b&gt; sur environ 5 W/(m^2 C). Utilisez une valeur plus élevée pour simuler un écoulement plus rapide.&lt;br&gt;Pour Rayonnement, spécifiez une valeur d'&lt;b&gt;émissivité/absorption&lt;/b&gt; entre 0 et 1. Utilisez une valeur plus faible pour les surfaces réflectives et une valeur plus élevée pour les surfaces émettrices plus foncées."/>
	<label commandName="SimThermalLoadTipsAndTricksTips" devLabel="Select the geometry where load will be placed. The geometry can be edges, faces, or vertices. You can select individual or multiple entities." translation="Sélectionnez la géométrie dans laquelle la charge sera placée. Il peut s'agir d'arêtes, de faces ou de sommets. Vous pouvez sélectionner une ou plusieurs entités."/>
